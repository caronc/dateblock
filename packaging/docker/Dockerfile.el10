#
# CentOS Stream 10 (EL10) build environment for dateblock (see the docker-* targets in
# GNUmakefile).  The build requirements come straight from the spec file,
# so this image always matches what the RPM build needs.
FROM quay.io/centos/centos:stream10

RUN dnf -y install dnf-plugins-core rpm-build git tar gzip && \
    dnf clean all

# CRB holds some of the build dependencies
RUN dnf config-manager --set-enabled crb

COPY packaging/redhat/dateblock.spec /tmp/dateblock.spec
RUN dnf -y builddep /tmp/dateblock.spec && dnf clean all && \
    rm -f /tmp/dateblock.spec
