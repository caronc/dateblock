#
# Builds the ready-built npm add-on for Linux with glibc (see docker-npm
# in GNUmakefile and packaging/npm/build.sh).  AlmaLinux 8 has the oldest
# glibc (2.28) and C++ runtime that Node.js 20 itself runs on, so an add-on
# built here runs wherever Node.js does.  Node.js 20, the oldest version
# the package supports, runs the tests.
FROM docker.io/library/almalinux:8

RUN dnf -y module enable nodejs:20 && \
    dnf -y install nodejs npm gcc-c++ make python3.11 git tar && \
    dnf clean all

# node-gyp needs a newer Python than AlmaLinux 8's own python3 (3.6)
ENV PYTHON=/usr/bin/python3.11
