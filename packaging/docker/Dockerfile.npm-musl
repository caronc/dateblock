#
# Builds the ready-built npm add-on for Linux with musl, ie: Alpine (see
# docker-npm in GNUmakefile and packaging/npm/build.sh).  The C++ runtime
# is built into the add-on, so it doesn't matter which Alpine version it
# runs on.  Node.js 20, the oldest version the package supports, runs the
# tests.
FROM docker.io/library/node:20-alpine

RUN apk add --no-cache build-base python3 git bash tar
