# Debian 13 (trixie) build environment for dateblock (see the docker-*
# targets in GNUmakefile).  The build requirements come straight from
# packaging/debian/control.
FROM docker.io/library/debian:trixie

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -y --no-install-recommends dpkg-dev lintian git tar \
        gzip ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY packaging/debian /tmp/src/debian
RUN apt-get update && apt-get build-dep -y /tmp/src && \
    rm -rf /var/lib/apt/lists/* /tmp/src
